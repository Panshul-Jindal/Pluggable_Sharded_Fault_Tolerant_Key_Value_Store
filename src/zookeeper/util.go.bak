func (srv *rfsrv) applyLoop(applyCh chan raftapi.ApplyMsg) {
	for m := range applyCh {
		if srv.ts.checkFinished() {
			return
		}
		
		srv.mu.Lock()
		
		// Validate that we're not applying uncommitted entries
		err_msg, _ := srv.ts.checkLogs(srv.me, m)
		if err_msg != "" {
			log.Fatalf("apply error: %s", err_msg)
		}
		
		srv.mu.Unlock()
	}
}

